{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@platform": ["./src/modules/super-admin/index.ts"],
      "@platform/*": ["./src/modules/super-admin/*"],
      "@organization": ["./src/modules/organization/index.ts"],
      "@organization/*": ["./src/modules/organization/*"],
      "@student": ["./src/modules/student/index.ts"],
      "@student/*": ["./src/modules/student/*"],
      "@guard": ["./src/modules/guard/index.ts"],
      "@guard/*": ["./src/modules/guard/*"],
      "@shared": ["./src/modules/shared/index.ts"],
      "@shared/*": ["./src/modules/shared/*"],
      "@core/*": ["./src/core/*"],
      "@/core/*": ["./src/core/*"],
      "@/modules/*": ["./src/modules/*"],
      "@/context/*": ["./src/core/context/*"],
      "@/components/*": ["./src/core/components/*"],
      "@/lib/*": ["./src/core/lib/*"],
      "@/hooks/*": ["./src/core/hooks/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
