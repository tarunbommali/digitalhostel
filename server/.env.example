# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# Database Connection URI (MongoDB 7+ Replica Set)
MONGO_URI=

# Security & Authentication (Generate using: openssl rand -base64 48)
JWT_SECRET=

# Allowed CORS Origins (Comma-separated, no wildcards in production)
CORS_ORIGIN=https://hostel.yourdomain.com

# Seeding & Migration Security Guards (Never populate in production)
SEED_DEFAULT_PASSWORD=
ALLOW_PRODUCTION_MIGRATION=false
